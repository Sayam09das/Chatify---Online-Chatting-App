# Main app ports
VITE_PORT=5173
VITE_API_PORT=3000

# Backend API URL
# If this is empty, frontend will use http://localhost:${VITE_API_PORT}
# For production: https://chatify-online-chatting-app.onrender.com
VITE_API_URL=https://chatify-online-chatting-app.onrender.com

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=yourgmail@gmail.com

